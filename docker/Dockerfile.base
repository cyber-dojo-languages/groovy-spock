FROM ghcr.io/cyber-dojo-languages/groovy:7361130
LABEL maintainer=jon@jaggersoft.com

RUN mkdir /groovy

# Spock publishes one build per groovy line, and this is the one for groovy
# 5.0, which covers the whole of groovy 5. The base resolves the newest
# stable groovy, so the first groovy 6 release will need the matching spock
# build rather than this one.
COPY spock-core-2.4-groovy-5.0.jar /groovy/

# The jars are taken from the distribution by glob rather than by name. The
# base resolves the newest stable groovy when it is built, so a name here
# would be a second copy of a version this image does not choose.
RUN cp ${GROOVY_HOME}/lib/groovy-[0-9]*.jar    /groovy/
RUN cp ${GROOVY_HOME}/lib/hamcrest-core-*.jar  /groovy/
RUN cp ${GROOVY_HOME}/lib/junit-4*.jar         /groovy/

ENV CLASSPATH=/groovy/

# cyber-dojo.sh runs this once, with the kata's spec files, rather than running
# groovy once per spec file. It explains why one JVM for all of them is what
# makes a kata with several specs no slower than a kata with one.
COPY run_spec_files.groovy /

# A kata's test run reads the AOT cache this leaves in /aot instead of loading
# those classes from the jars again on every [test] press. The script explains
# which classes it holds.
COPY throwaway_kata /tmp/throwaway_kata
COPY record_aot_cache.sh /tmp/
RUN bash /tmp/record_aot_cache.sh \
 && rm -rf /tmp/record_aot_cache.sh /tmp/throwaway_kata

